# URL del modelo local (por ejemplo Ollama, LocalAI, vLLM, llama.cpp, etc.)
LOCAL_MODEL_URL=http://localhost:8000/v1

# Nombre del modelo local
LOCAL_MODEL_NAME=local-model

# API Key simulada (generalmente no requerida por modelos locales pero requerida por ChatOpenAI)
SIMULATED_API_KEY=mock-api-key-12345

# Tiempo de espera (timeout) para las llamadas al LLM en segundos
LLM_TIMEOUT=30

# Tiempo de espera (timeout) para la validación asíncrona de la URL en segundos
URL_VALIDATION_TIMEOUT=5

# Puerto de escucha del webhook de FastAPI (estándar en OpenShift)
AGENT_PORT=8080

# Nivel de log para la aplicación
LOG_LEVEL=INFO
